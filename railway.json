{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": ["server.js", "index.html", "data.js", "peers.js", "signals.js", "prices.js", "package.json", "package-lock.json", "railway.json"]
  },
  "deploy": {
    "startCommand": "node server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
